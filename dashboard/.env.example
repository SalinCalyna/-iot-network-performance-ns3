# Copy this file to .env and fill in your own key. Never commit .env.
#
# Get a key: https://developers.google.com/maps/documentation/javascript/get-api-key
# Restrict it (HTTP referrers) to localhost / your own domain in the Google
# Cloud Console before using it anywhere but local development.
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
